# ============================================================
# YYC3-AI-FAmily-Agent- · yyc3-music-api 环境模板
# 复制为 services/yyc3-music-api/.env 并按实际填值（.env 不入库）
# ============================================================

# 主库：NAS PG 17（写 + 默认读）——宿主上部署时 host 用 NAS 内网 IP
#postgresql://yyc3_music:<密码>@192.168.3.X:5433/yyc3_music
PG_PRIMARY_URL=postgresql://postgres:postgres@host.docker.internal:5433/yyc3_music

# 备库：本机 PG 17 · 5433（只读降级兜底，可留空禁用）
PG_STANDBY_URL=postgresql://postgres@192.168.3.Y:5433/yyc3_music

# 监听（标规：开发端口自 3030 起）
PORT=3030
HOST=0.0.0.0

# 家用单用户键
DEFAULT_USER_KEY=family

# CORS 允许来源（逗号分隔；"*" 放行任意来源，仅限可信内网）
# 缺省已含本地开发端口、Pages 生产域 matrix.yyc3.vip 与 Electron file://（Origin: null）
#CORS_ORIGINS=http://localhost:3218,https://matrix.yyc3.vip,null
