# ============================================================
# 言语云枢·智能矩阵（YYC³ CloudPivot Matrix Ops）环境变量示例
# 命名规范 §三：应用级变量统一使用 PMO_ 前缀
# （VITE_YYC3_ 历史前缀仍兼容，优先级 PMO_ > VITE_YYC3_）
# ============================================================

# ── 系统标识 ──
PMO_SYSTEM_NAME=言语云枢 · YYC³ CloudPivot Matrix Ops 异构算力矩阵运维面板 v3.4.1
PMO_SYSTEM_VERSION=3.4.1

# ── 网络端点 ──
PMO_API_BASE=http://localhost:3113/api
PMO_WS_ENDPOINT=ws://localhost:3113/ws
PMO_OLLAMA_BASE_URL=http://localhost:11434
PMO_NODE_TOKEN=

# ── 集群与存储 ──
PMO_CLUSTER_ID=CN-EAST-PROD-01
PMO_STORAGE_PREFIX=yyc3_

# ── 开关 ──
PMO_ENABLE_MOCK=true
PMO_ENABLE_DEBUG=false

# ── AI 密钥（按需填写，勿提交真实密钥） ──
PMO_ZHIPU_API_KEY=your_zhipu_api_key_here
PMO_DEEPSEEK_API_KEY=

# ── 第三方服务（保留 VITE_ 前缀，行业惯例） ──
# （supabase 已全量退役——落档 33：认证走 lib/mock-auth，数据本地持久）

# ── 音乐空间 API（services/yyc3-music-api · NAS 常驻） ──
# 浏览器端基址；留空 = 内置曲库离线模式（功能完整，无推荐/收藏持久化）
# NAS 局域网: http://192.168.3.45:3030 · Tailscale 外出: http://100.65.172.88:3030
# 也可运行时覆盖：localStorage["yyc3.music.apiBase"]
VITE_AFH_MUSIC_API_BASE=
